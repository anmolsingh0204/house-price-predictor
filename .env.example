# House Price Predictor - Environment Variables
# Copy to .env and customize

# Application
APP_ENV=development          # development, staging, production
DEBUG=True
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4

# WebSocket Server
WS_HOST=0.0.0.0
WS_PORT=8765

# Model Paths
MODEL_PATH=models/house_price_model.pkl
PREPROCESSOR_PATH=models/preprocessor.pkl
FEATURE_IMPORTANCE_PATH=models/feature_importance.json

# Database (if using)
# DATABASE_URL=postgresql://user:pass@localhost:5432/house_predictor
# REDIS_URL=redis://localhost:6379/0

# External APIs (if integrating real data)
# ZILLOW_API_KEY=
# REFINITIV_API_KEY=
# FRED_API_KEY=

# Security
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Monitoring (optional)
# SENTRY_DSN=
# DATADOG_API_KEY=

# ML Configuration
RETRAIN_SCHEDULE=0 2 * * 0  # Weekly Sunday 2AM UTC
MIN_TRAINING_SAMPLES=10000
MODEL_QUALITY_THRESHOLD_R2=0.90
MODEL_QUALITY_THRESHOLD_RMSE=80000